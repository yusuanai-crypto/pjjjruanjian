{
  "name": "jiangjiu-api",
  "version": "0.1.0",
  "private": true,
  "description": "Jiangjiu internal business API, phase 0 preparation confirmation and phase 1 auth modules.",
  "type": "commonjs",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:legacy": "node src/main.js",
    "test": "node --test --require ts-node/register test/*.test.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "deploy:pm2:safe": "bash scripts/deploy-api-pm2.sh",
    "test:guide-points:mysql": "node scripts/run-guide-points-isolated-mysql-test.js",
    "test:guide-points:mysql:schema": "node scripts/run-guide-points-isolated-mysql-test.js --schema-push",
    "seed:stage10-products": "node scripts/seed-stage10-products.js",
    "sample:moutai-logistics": "node --require ts-node/register scripts/generate-moutai-logistics-samples.js",
    "retention:cleanup": "ts-node scripts/cleanup-retained-data.ts",
    "migrate:legacy-json": "node scripts/migrate-legacy-json.js",
    "backfill:sales-order-customers": "node scripts/backfill-sales-order-customers.js",
    "backfill:sales-order-shipping-dates": "ts-node scripts/backfill-sales-order-shipping-dates.ts",
    "backfill:todo-reminders": "ts-node scripts/backfill-todo-reminders.ts",
    "backfill:after-sales-independent-orders": "ts-node scripts/backfill-after-sales-independent-orders.ts",
    "backfill:profit-fee-snapshots": "ts-node scripts/backfill-profit-fee-snapshots.ts",
    "backfill:order-level-commissions": "ts-node scripts/backfill-order-level-commissions.ts",
    "backfill:agency-rebate-rule-agency-ids": "ts-node scripts/backfill-agency-rebate-rule-agency-ids.ts",
    "backfill:warehouse-products": "ts-node scripts/backfill-warehouse-product-configurations.ts",
    "preflight:special-orders": "ts-node scripts/preflight-special-orders.ts",
    "preflight:employee-commission-assignments": "ts-node scripts/preflight-employee-commission-assignments.ts",
    "verify:commission-schema": "ts-node scripts/verify-commission-schema.ts",
    "verify:guide-points-schema": "ts-node scripts/verify-guide-points-schema.ts",
    "cutover:inventory": "ts-node scripts/inventory-cutover.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/schedule": "^4.1.2",
    "@prisma/client": "^6.19.0",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "jszip": "3.10.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/testing": "^10.4.15",
    "@types/node": "^22.10.2",
    "prisma": "^6.19.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  }
}
