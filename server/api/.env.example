ATTACHMENT_UPLOAD_TEMP_DIR=".private/attachment-upload-tmp"
ATTACHMENT_UPLOAD_MAX_FILE_BYTES="10485760"
ATTACHMENT_UPLOAD_MAX_FILES="5"
ATTACHMENT_UPLOAD_MAX_REQUEST_BYTES="26214400"
