generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// 当前 schema 已包含登录权限、系统设置、操作日志，以及当前业务 API 使用的业务基础表。
// 已落库业务表：travel_agencies、guides、travel_groups、guide_carried_groups、pending_travel_groups、customers、sales_orders、
// sales_order_items、after_sales_orders、agency_deduction_rules、agency_rebate_rules、sales_deduction_rules、
// commission_rules、commission_records、travel_group_finance_summaries、daily_reconciliations、
// reconciliation_payment_methods、strike_bonus_awards。
// AI 等完整目标表仍按后续阶段追加 migration。
enum UserRole {
  SUPER_ADMIN @map("super_admin")
  ADMIN       @map("admin")
  BOSS        @map("boss")
  FRONT_DESK  @map("front_desk")
  SALES       @map("sales")
  FINANCE     @map("finance")
  WAREHOUSE   @map("warehouse")
  AFTER_SALES @map("after_sales")
  TASTER      @map("taster")

  @@map("user_role")
}

enum TodoSourceType {
  TRAVEL_GROUP      @map("travel_group")
  SALES_ORDER       @map("sales_order")
  AFTER_SALES_ORDER @map("after_sales_order")
  INVENTORY_ALERT   @map("inventory_alert")
  STOCKTAKE         @map("stocktake")

  @@map("todo_source_type")
}

enum TodoPriority {
  NORMAL    @map("normal")
  IMPORTANT @map("important")
  URGENT    @map("urgent")

  @@map("todo_priority")
}

enum TodoStatus {
  ACTIVE    @map("active")
  RESOLVED  @map("resolved")
  CANCELLED @map("cancelled")

  @@map("todo_status")
}

enum TodoRecipientReason {
  BUSINESS   @map("business")
  ESCALATION @map("escalation")

  @@map("todo_recipient_reason")
}

model User {
  id                 String    @id @default(uuid()) @db.Char(36)
  name               String    @db.VarChar(100)
  username           String    @unique @db.VarChar(100)
  passwordHash       String    @map("password_hash") @db.VarChar(255)
  role               UserRole
  phone              String?   @unique @db.VarChar(30)
  leaderId           String?   @map("leader_id") @db.Char(36)
  isActive           Boolean   @default(true) @map("is_active")
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  tokenVersion       Int       @default(0) @map("token_version")
  statusReason       String?   @map("status_reason") @db.VarChar(255)
  statusChangedAt    DateTime? @map("status_changed_at") @db.DateTime(0)
  statusChangedBy    String?   @map("status_changed_by") @db.Char(36)
  createdAt          DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.DateTime(0)

  leader                                User?                           @relation("UserLeader", fields: [leaderId], references: [id], onDelete: SetNull)
  members                               User[]                          @relation("UserLeader")
  updatedSystemSettings                 SystemSetting[]                 @relation("SystemSettingUpdatedBy")
  operationLogs                         OperationLog[]
  tasterTravelGroups                    TravelGroup[]                   @relation("TravelGroupTaster")
  liaisonTasterTravelGroups             TravelGroup[]                   @relation("TravelGroupLiaisonTaster")
  notEnteredConfirmedTravelGroups       TravelGroup[]                   @relation("TravelGroupNotEnteredConfirmedBy")
  lossConfirmedTravelGroups             TravelGroup[]                   @relation("TravelGroupLossConfirmedBy")
  tasterGuideGroups                     GuideCarriedGroup[]             @relation("GuideCarriedGroupTaster")
  tasterPendingGroups                   PendingTravelGroup[]            @relation("PendingTravelGroupTaster")
  salesOrders                           SalesOrder[]                    @relation("SalesOrderSalesUser")
  markedTravelGroups                    TravelGroup[]                   @relation("TravelGroupMarkedBy")
  markedGuideGroups                     GuideCarriedGroup[]             @relation("GuideCarriedGroupMarkedBy")
  markedPendingGroups                   PendingTravelGroup[]            @relation("PendingTravelGroupMarkedBy")
  markedSalesOrders                     SalesOrder[]                    @relation("SalesOrderMarkedBy")
  completedSalesOrders                  SalesOrder[]                    @relation("SalesOrderCompletedBy")
  lockedPaymentDetailSalesOrders        SalesOrder[]                    @relation("SalesOrderPaymentDetailsLockedBy")
  unlockedPaymentDetailSalesOrders      SalesOrder[]                    @relation("SalesOrderPaymentDetailsUnlockedBy")
  profitFeeSnapshottedSalesOrders       SalesOrder[]                    @relation("SalesOrderProfitFeeSnapshottedBy")
  createdPaymentMethods                 PaymentMethod[]                 @relation("PaymentMethodCreatedBy")
  updatedPaymentMethods                 PaymentMethod[]                 @relation("PaymentMethodUpdatedBy")
  confirmedSalesOrderPaymentDetails     SalesOrderPaymentDetail[]       @relation("SalesOrderPaymentDetailCollectionConfirmedBy")
  markedCustomers                       Customer[]                      @relation("CustomerMarkedBy")
  financeConfirmedAfterSalesOrders      AfterSalesOrder[]               @relation("AfterSalesOrderFinanceConfirmedBy")
  warehouseConfirmedAfterSalesOrders    AfterSalesOrder[]               @relation("AfterSalesOrderWarehouseConfirmedBy")
  handledAfterSalesOrders               AfterSalesOrder[]               @relation("AfterSalesOrderHandledBy")
  createdAfterSalesOrders               AfterSalesOrder[]               @relation("AfterSalesOrderCreatedBy")
  updatedAfterSalesOrders               AfterSalesOrder[]               @relation("AfterSalesOrderUpdatedBy")
  outreachSalesOrders                   SalesOrder[]                    @relation("SalesOrderOutreachUser")
  createdAgencyDeductionRules           AgencyDeductionRule[]           @relation("AgencyDeductionRuleCreatedBy")
  updatedAgencyDeductionRules           AgencyDeductionRule[]           @relation("AgencyDeductionRuleUpdatedBy")
  createdAgencyRebateRules              AgencyRebateRule[]              @relation("AgencyRebateRuleCreatedBy")
  updatedAgencyRebateRules              AgencyRebateRule[]              @relation("AgencyRebateRuleUpdatedBy")
  createdSalesDeductionRules            SalesDeductionRule[]            @relation("SalesDeductionRuleCreatedBy")
  updatedSalesDeductionRules            SalesDeductionRule[]            @relation("SalesDeductionRuleUpdatedBy")
  createdCommissionRules                CommissionRule[]                @relation("CommissionRuleCreatedBy")
  updatedCommissionRules                CommissionRule[]                @relation("CommissionRuleUpdatedBy")
  todoRecipients                        TodoRecipient[]
  targetCommissionRecords               CommissionRecord[]              @relation("CommissionRecordTargetUser")
  confirmedCommissionRecords            CommissionRecord[]              @relation("CommissionRecordConfirmedBy")
  createdCommissionRecords              CommissionRecord[]              @relation("CommissionRecordCreatedBy")
  updatedCommissionRecords              CommissionRecord[]              @relation("CommissionRecordUpdatedBy")
  confirmedTravelGroupSummaries         TravelGroupFinanceSummary[]     @relation("TravelGroupFinanceSummaryAgencyDeductionConfirmedBy")
  dailyRebatePaidTravelSummaries        TravelGroupFinanceSummary[]     @relation("TravelGroupFinanceSummaryDailyRebatePaidBy")
  monthlyRebatePaidTravelSummaries      TravelGroupFinanceSummary[]     @relation("TravelGroupFinanceSummaryMonthlyRebatePaidBy")
  updatedTravelGroupSummaries           TravelGroupFinanceSummary[]     @relation("TravelGroupFinanceSummaryUpdatedBy")
  pointsDestinationChangedOrders        SalesOrder[]                    @relation("SalesOrderPointsDestinationChangedBy")
  personalRatesUpdatedOrders            SalesOrder[]                    @relation("SalesOrderPersonalRatesUpdatedBy")
  dailyPointsPaidGuideSummaries         GuidePointsSummary[]            @relation("GuidePointsSummaryDailyPointsPaidBy")
  monthlyPointsPaidGuideSummaries       GuidePointsSummary[]            @relation("GuidePointsSummaryMonthlyPointsPaidBy")
  updatedGuidePointsSummaries           GuidePointsSummary[]            @relation("GuidePointsSummaryUpdatedBy")
  reviewedDailyReconciliations          DailyReconciliation[]           @relation("DailyReconciliationReviewedBy")
  aiChatMessages                        AiChatMessage[]                 @relation("AiChatMessageUser")
  createdProducts                       Product[]                       @relation("ProductCreatedBy")
  updatedProducts                       Product[]                       @relation("ProductUpdatedBy")
  createdProductActualCosts             ProductActualCost[]             @relation("ProductActualCostCreatedBy")
  updatedProductActualCosts             ProductActualCost[]             @relation("ProductActualCostUpdatedBy")
  createdSerializedInventoryUnits       SerializedInventoryUnit[]       @relation("SerializedInventoryUnitCreatedBy")
  updatedSerializedInventoryUnits       SerializedInventoryUnit[]       @relation("SerializedInventoryUnitUpdatedBy")
  correctedSerializedInventoryUnits     SerializedInventoryUnit[]       @relation("SerializedInventoryUnitCorrectedBy")
  reservedSerializedAssignments         SerializedInventoryAssignment[] @relation("SerializedInventoryAssignmentReservedBy")
  outboundSerializedAssignments         SerializedInventoryAssignment[] @relation("SerializedInventoryAssignmentOutboundBy")
  releasedSerializedAssignments         SerializedInventoryAssignment[] @relation("SerializedInventoryAssignmentReleasedBy")
  confirmedAfterSalesReceipts           AfterSalesReceipt[]             @relation("AfterSalesReceiptConfirmedBy")
  reversedAfterSalesReceipts            AfterSalesReceipt[]             @relation("AfterSalesReceiptReversedBy")
  createdAfterSalesReceipts             AfterSalesReceipt[]             @relation("AfterSalesReceiptCreatedBy")
  updatedAfterSalesReceipts             AfterSalesReceipt[]             @relation("AfterSalesReceiptUpdatedBy")
  createdSpecialOrders                  SalesOrder[]                    @relation("SpecialOrderCreatedBy")
  updatedSpecialOrders                  SalesOrder[]                    @relation("SpecialOrderUpdatedBy")
  internalEmployeeSpecialOrders         SalesOrder[]                    @relation("SpecialOrderInternalEmployee")
  approvedSpecialOrders                 SalesOrder[]                    @relation("SpecialOrderApprovedBy")
  specialOrderWorkflowEvents            SpecialOrderWorkflowEvent[]     @relation("SpecialOrderWorkflowEventActor")
  uploadedSpecialOrderAttachments       SpecialOrderAttachment[]        @relation("SpecialOrderAttachmentUploadedBy")
  recordedSpecialOrderPayments          SpecialOrderPayment[]           @relation("SpecialOrderPaymentRecordedBy")
  reversedSpecialOrderSettlements       SpecialOrderSettlement[]        @relation("SpecialOrderSettlementReversedBy")
  managedWarehouses                     Warehouse[]                     @relation("WarehouseManager")
  createdWarehouses                     Warehouse[]                     @relation("WarehouseCreatedBy")
  updatedWarehouses                     Warehouse[]                     @relation("WarehouseUpdatedBy")
  createdWarehouseProductConfigurations WarehouseProductConfiguration[] @relation("WarehouseProductConfigurationCreatedBy")
  updatedWarehouseProductConfigurations WarehouseProductConfiguration[] @relation("WarehouseProductConfigurationUpdatedBy")
  createdInventoryConfigurations        InventoryConfiguration[]        @relation("InventoryConfigurationCreatedBy")
  updatedInventoryConfigurations        InventoryConfiguration[]        @relation("InventoryConfigurationUpdatedBy")
  costCompletedInventoryBatches         InventoryBatch[]                @relation("InventoryBatchCostCompletedBy")
  createdInventoryBatches               InventoryBatch[]                @relation("InventoryBatchCreatedBy")
  updatedInventoryBatches               InventoryBatch[]                @relation("InventoryBatchUpdatedBy")
  postedInventoryDocuments              InventoryDocument[]             @relation("InventoryDocumentPostedBy")
  reversedInventoryDocuments            InventoryDocument[]             @relation("InventoryDocumentReversedBy")
  createdInventoryDocuments             InventoryDocument[]             @relation("InventoryDocumentCreatedBy")
  updatedInventoryDocuments             InventoryDocument[]             @relation("InventoryDocumentUpdatedBy")
  submittedStocktakes                   Stocktake[]                     @relation("StocktakeSubmittedBy")
  approvedStocktakes                    Stocktake[]                     @relation("StocktakeApprovedBy")
  rejectedStocktakes                    Stocktake[]                     @relation("StocktakeRejectedBy")
  postedStocktakes                      Stocktake[]                     @relation("StocktakePostedBy")
  reversedStocktakes                    Stocktake[]                     @relation("StocktakeReversedBy")
  createdStocktakes                     Stocktake[]                     @relation("StocktakeCreatedBy")
  updatedStocktakes                     Stocktake[]                     @relation("StocktakeUpdatedBy")
  operatedInventoryMovements            InventoryMovement[]             @relation("InventoryMovementOperator")
  inventoryCommandReceipts              InventoryCommandReceipt[]       @relation("InventoryCommandReceiptActor")
  createdInventoryTransfers             InventoryTransfer[]             @relation("InventoryTransferCreatedBy")
  updatedInventoryTransfers             InventoryTransfer[]             @relation("InventoryTransferUpdatedBy")
  outboundInventoryTransfers            InventoryTransfer[]             @relation("InventoryTransferOutboundBy")
  confirmedInventoryTransferReceipts    InventoryTransferReceipt[]      @relation("InventoryTransferReceiptConfirmedBy")
  createdStockAlertConfigs              StockAlertConfig[]              @relation("StockAlertConfigCreatedBy")
  updatedStockAlertConfigs              StockAlertConfig[]              @relation("StockAlertConfigUpdatedBy")
  requestedInventoryModeChanges         ProductInventoryModeChange[]    @relation("ProductInventoryModeChangeRequestedBy")
  appliedInventoryModeChanges           ProductInventoryModeChange[]    @relation("ProductInventoryModeChangeAppliedBy")
  refreshSessions                       RefreshSession[]

  @@index([role])
  @@index([leaderId])
  @@index([statusChangedBy])
  @@map("users")
}

model BusinessTodo {
  id              String         @id @default(uuid()) @db.Char(36)
  ruleCode        String         @map("rule_code") @db.VarChar(80)
  sourceType      TodoSourceType @map("source_type")
  sourceId        String         @map("source_id") @db.Char(36)
  targetRole      UserRole       @map("target_role")
  title           String         @db.VarChar(160)
  content         String         @db.VarChar(500)
  priority        TodoPriority   @default(NORMAL)
  status          TodoStatus     @default(ACTIVE)
  dueAt           DateTime       @map("due_at") @db.DateTime(0)
  sourceSnapshot  Json?          @map("source_snapshot")
  firstDetectedAt DateTime       @default(now()) @map("first_detected_at") @db.DateTime(0)
  lastDetectedAt  DateTime       @default(now()) @map("last_detected_at") @db.DateTime(0)
  resolvedAt      DateTime?      @map("resolved_at") @db.DateTime(0)
  createdAt       DateTime       @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.DateTime(0)

  recipients TodoRecipient[]

  @@unique([ruleCode, sourceType, sourceId], map: "business_todos_rule_source_key")
  @@index([status, dueAt], map: "business_todos_status_due_at_idx")
  @@index([sourceType, sourceId], map: "business_todos_source_idx")
  @@index([targetRole, status], map: "business_todos_target_role_status_idx")
  @@index([status, lastDetectedAt], map: "business_todos_status_detected_idx")
  @@map("business_todos")
}

model TodoReconcileCursor {
  id        String    @id @default(uuid()) @db.Char(36)
  scanType  String    @unique(map: "todo_reconcile_cursors_scan_type_key") @map("scan_type") @db.VarChar(80)
  cursorId  String?   @map("cursor_id") @db.Char(36)
  wrappedAt DateTime? @map("wrapped_at") @db.DateTime(0)
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.DateTime(0)

  @@index([updatedAt], map: "todo_reconcile_cursors_updated_at_idx")
  @@map("todo_reconcile_cursors")
}

model TodoRecipient {
  id               String              @id @default(uuid()) @db.Char(36)
  todoId           String              @map("todo_id") @db.Char(36)
  userId           String              @map("user_id") @db.Char(36)
  recipientReason  TodoRecipientReason @default(BUSINESS) @map("recipient_reason")
  readAt           DateTime?           @map("read_at") @db.DateTime(0)
  personalNote     String?             @map("personal_note") @db.Text
  personalRemindAt DateTime?           @map("personal_remind_at") @db.DateTime(0)
  snoozedUntil     DateTime?           @map("snoozed_until") @db.DateTime(0)
  archivedAt       DateTime?           @map("archived_at") @db.DateTime(0)
  createdAt        DateTime            @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt        DateTime            @updatedAt @map("updated_at") @db.DateTime(0)

  todo BusinessTodo @relation(fields: [todoId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([todoId, userId], map: "todo_recipients_todo_user_key")
  @@index([userId, archivedAt, createdAt], map: "todo_recipients_user_archive_created_idx")
  @@index([todoId, recipientReason], map: "todo_recipients_todo_reason_idx")
  @@index([userId, readAt], map: "todo_recipients_user_read_idx")
  @@index([personalRemindAt], map: "todo_recipients_remind_at_idx")
  @@map("todo_recipients")
}

model RefreshSession {
  id                  String    @id @default(uuid()) @db.Char(36)
  userId              String    @map("user_id") @db.Char(36)
  tokenHash           String    @unique @map("token_hash") @db.Char(64)
  familyId            String    @map("family_id") @db.Char(36)
  tokenVersion        Int       @map("token_version")
  expiresAt           DateTime  @map("expires_at") @db.DateTime(3)
  revokedAt           DateTime? @map("revoked_at") @db.DateTime(3)
  replacedBySessionId String?   @map("replaced_by_session_id") @db.Char(36)
  revokeReason        String?   @map("revoke_reason") @db.VarChar(64)
  lastUsedAt          DateTime? @map("last_used_at") @db.DateTime(3)
  createdAt           DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("refresh_sessions")
}

enum SmsVerificationPurpose {
  RESET_PASSWORD @map("reset_password")

  @@map("sms_verification_purpose")
}

model SmsVerificationCode {
  id           String                 @id @default(uuid()) @db.Char(36)
  phone        String                 @db.VarChar(30)
  userId       String?                @map("user_id") @db.Char(36)
  purpose      SmsVerificationPurpose
  codeHash     String                 @map("code_hash") @db.VarChar(255)
  activeKey    String?                @unique @map("active_key") @db.VarChar(191)
  expiresAt    DateTime               @map("expires_at") @db.DateTime(0)
  consumedAt   DateTime?              @map("consumed_at") @db.DateTime(0)
  attemptCount Int                    @default(0) @map("attempt_count")
  createdById  String?                @map("created_by_id") @db.Char(36)
  provider     String?                @db.VarChar(32)
  providerRef  String?                @map("provider_ref") @db.VarChar(128)
  createdAt    DateTime               @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt    DateTime               @updatedAt @map("updated_at") @db.DateTime(0)

  @@index([phone, purpose, createdAt])
  @@index([userId])
  @@index([expiresAt])
  @@map("sms_verification_codes")
}

model RateLimitCounter {
  keyFingerprint String   @id @map("key_fingerprint") @db.Char(64)
  scope          String   @db.VarChar(64)
  windowStartAt  DateTime @map("window_start_at") @db.DateTime(3)
  windowEndAt    DateTime @map("window_end_at") @db.DateTime(3)
  requestCount   Int      @default(0) @map("request_count")
  updatedAt      DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  @@index([windowEndAt], map: "rate_limit_counters_window_end_idx")
  @@map("rate_limit_counters")
}

model SystemSetting {
  id           String   @id @default(uuid()) @db.Char(36)
  settingKey   String   @unique @map("setting_key") @db.VarChar(191)
  settingValue String   @map("setting_value") @db.Text
  updatedBy    String?  @map("updated_by") @db.Char(36)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.DateTime(0)

  updater User? @relation("SystemSettingUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@index([updatedBy])
  @@map("system_settings")
}

model OperationLog {
  id                    String              @id @default(uuid()) @db.Char(36)
  userId                String?             @map("user_id") @db.Char(36)
  actorNameSnapshot     String?             @map("actor_name_snapshot") @db.VarChar(100)
  actorUsernameSnapshot String?             @map("actor_username_snapshot") @db.VarChar(100)
  actorRoleSnapshot     String?             @map("actor_role_snapshot") @db.VarChar(32)
  module                String?             @db.VarChar(100)
  operationType         OperationLogType?   @map("operation_type")
  action                String              @db.VarChar(100)
  entityType            String              @map("entity_type") @db.VarChar(100)
  entityId              String?             @map("entity_id") @db.VarChar(100)
  result                OperationLogResult?
  beforeData            Json?               @map("before_data")
  afterData             Json?               @map("after_data")
  requestSummary        Json?               @map("request_summary")
  sanitizationSummary   Json?               @map("sanitization_summary")
  httpMethod            String?             @map("http_method") @db.VarChar(10)
  requestPath           String?             @map("request_path") @db.VarChar(255)
  requestId             String?             @map("request_id") @db.VarChar(64)
  statusCode            Int?                @map("status_code")
  errorCode             String?             @map("error_code") @db.VarChar(100)
  errorMessage          String?             @map("error_message") @db.VarChar(512)
  userAgent             String?             @map("user_agent") @db.VarChar(512)
  durationMs            Int?                @map("duration_ms")
  ipAddress             String?             @map("ip_address") @db.VarChar(45)
  archivedAt            DateTime?           @map("archived_at") @db.DateTime(3)
  createdAt             DateTime            @default(now()) @map("created_at") @db.DateTime(0)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, createdAt], map: "operation_logs_user_created_idx")
  @@index([module, createdAt], map: "operation_logs_module_created_idx")
  @@index([operationType, createdAt], map: "operation_logs_type_created_idx")
  @@index([result, createdAt], map: "operation_logs_result_created_idx")
  @@index([entityType, entityId])
  @@index([requestId])
  @@index([createdAt])
  @@map("operation_logs")
}

model OperationLogArchive {
  id                    String              @id @db.Char(36)
  userId                String?             @map("user_id") @db.Char(36)
  actorNameSnapshot     String?             @map("actor_name_snapshot") @db.VarChar(100)
  actorUsernameSnapshot String?             @map("actor_username_snapshot") @db.VarChar(100)
  actorRoleSnapshot     String?             @map("actor_role_snapshot") @db.VarChar(32)
  module                String?             @db.VarChar(100)
  operationType         OperationLogType?   @map("operation_type")
  action                String              @db.VarChar(100)
  entityType            String              @map("entity_type") @db.VarChar(100)
  entityId              String?             @map("entity_id") @db.VarChar(100)
  result                OperationLogResult?
  beforeData            Json?               @map("before_data")
  afterData             Json?               @map("after_data")
  requestSummary        Json?               @map("request_summary")
  sanitizationSummary   Json?               @map("sanitization_summary")
  httpMethod            String?             @map("http_method") @db.VarChar(10)
  requestPath           String?             @map("request_path") @db.VarChar(255)
  requestId             String?             @map("request_id") @db.VarChar(64)
  statusCode            Int?                @map("status_code")
  errorCode             String?             @map("error_code") @db.VarChar(100)
  errorMessage          String?             @map("error_message") @db.VarChar(512)
  userAgent             String?             @map("user_agent") @db.VarChar(512)
  durationMs            Int?                @map("duration_ms")
  ipAddress             String?             @map("ip_address") @db.VarChar(45)
  archivedAt            DateTime            @default(now()) @map("archived_at") @db.DateTime(3)
  createdAt             DateTime            @map("created_at") @db.DateTime(0)

  @@index([userId, createdAt], map: "operation_log_archives_user_created_idx")
  @@index([module, createdAt], map: "operation_log_archives_module_created_idx")
  @@index([operationType, createdAt], map: "operation_log_archives_type_created_idx")
  @@index([result, createdAt], map: "operation_log_archives_result_created_idx")
  @@index([entityType, entityId], map: "operation_log_archives_entity_idx")
  @@index([requestId], map: "operation_log_archives_request_id_idx")
  @@index([createdAt], map: "operation_log_archives_created_idx")
  @@index([archivedAt], map: "operation_log_archives_archived_idx")
  @@map("operation_log_archives")
}

enum OperationLogType {
  CREATE
  READ
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  IMPORT
  EXPORT
  UPLOAD
  DOWNLOAD
  REVIEW
  STATUS_CHANGE
  OTHER

  @@map("operation_log_type")
}

enum OperationLogResult {
  SUCCESS
  FAILURE

  @@map("operation_log_result")
}

model AiChatMessage {
  id               String   @id @default(uuid()) @db.Char(36)
  conversationId   String?  @map("conversation_id") @db.VarChar(64)
  userId           String   @map("user_id") @db.Char(36)
  userRole         String   @map("user_role") @db.VarChar(32)
  question         String   @db.Text
  answer           String   @db.Text
  intent           String?  @db.VarChar(64)
  dataScope        Json?    @map("data_scope")
  toolCalls        Json?    @map("tool_calls")
  sourceSummary    Json?    @map("source_summary")
  warnings         Json?
  modelProvider    String?  @map("model_provider") @db.VarChar(64)
  modelName        String?  @map("model_name") @db.VarChar(128)
  promptTokens     Int?     @map("prompt_tokens")
  completionTokens Int?     @map("completion_tokens")
  latencyMs        Int?     @map("latency_ms")
  errorCode        String?  @map("error_code") @db.VarChar(64)
  createdAt        DateTime @default(now()) @map("created_at") @db.DateTime(0)

  user User @relation("AiChatMessageUser", fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([conversationId, createdAt])
  @@index([intent, createdAt])
  @@map("ai_chat_messages")
}

enum InventoryTrackingMode {
  NONE       @map("none")
  QUANTITY   @map("quantity")
  SERIALIZED @map("serialized")

  @@map("inventory_tracking_mode")
}

enum SerializedInventoryStatus {
  PENDING_COST @map("pending_cost")
  AVAILABLE    @map("available")
  ALLOCATED    @map("allocated")
  RESERVED     @map("reserved")
  OUTBOUND     @map("outbound")
  UNAVAILABLE  @map("unavailable")
  VOID         @map("void")

