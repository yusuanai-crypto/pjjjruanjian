generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// 当前 schema 已包含登录权限、系统设置、操作日志，以及当前业务 API 使用的业务基础表。
// 已落库业务表：travel_agencies、guides、travel_groups、guide_carried_groups、pending_travel_groups、customers、sales_orders、
// sales_order_items、after_sales_orders、agency_deduction_rules、agency_rebate_rules、sales_deduction_rules、
// commission_rules、commission_records、travel_group_finance_summaries、daily_reconciliations、
// reconciliation_payment_methods、strike_bonus_awards。
// AI 等完整目标表仍按后续阶段追加 migration。
enum UserRole {
  SUPER_ADMIN @map("super_admin")
  ADMIN       @map("admin")
  BOSS        @map("boss")
  FRONT_DESK  @map("front_desk")
  SALES       @map("sales")
  FINANCE     @map("finance")
  WAREHOUSE   @map("warehouse")
  AFTER_SALES @map("after_sales")
  TASTER      @map("taster")

  @@map("user_role")
}

model User {
  id                 String    @id @default(uuid()) @db.Char(36)
  name               String    @db.VarChar(100)
  username           String    @unique @db.VarChar(100)
  passwordHash       String    @map("password_hash") @db.VarChar(255)
  role               UserRole
  phone              String?   @unique @db.VarChar(30)
  leaderId           String?   @map("leader_id") @db.Char(36)
  isActive           Boolean   @default(true) @map("is_active")
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  tokenVersion       Int       @default(0) @map("token_version")
  statusReason       String?   @map("status_reason") @db.VarChar(255)
  statusChangedAt    DateTime? @map("status_changed_at") @db.DateTime(0)
  statusChangedBy    String?   @map("status_changed_by") @db.Char(36)
  createdAt          DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.DateTime(0)

  leader                           User?                       @relation("UserLeader", fields: [leaderId], references: [id], onDelete: SetNull)
  members                          User[]                      @relation("UserLeader")
  updatedSystemSettings            SystemSetting[]             @relation("SystemSettingUpdatedBy")
  operationLogs                    OperationLog[]
  tasterTravelGroups               TravelGroup[]               @relation("TravelGroupTaster")
  liaisonTasterTravelGroups        TravelGroup[]               @relation("TravelGroupLiaisonTaster")
  tasterGuideGroups                GuideCarriedGroup[]         @relation("GuideCarriedGroupTaster")
  tasterPendingGroups              PendingTravelGroup[]        @relation("PendingTravelGroupTaster")
  salesOrders                      SalesOrder[]                @relation("SalesOrderSalesUser")
  markedTravelGroups               TravelGroup[]               @relation("TravelGroupMarkedBy")
  markedGuideGroups                GuideCarriedGroup[]         @relation("GuideCarriedGroupMarkedBy")
  markedPendingGroups              PendingTravelGroup[]        @relation("PendingTravelGroupMarkedBy")
  markedSalesOrders                SalesOrder[]                @relation("SalesOrderMarkedBy")
  markedCustomers                  Customer[]                  @relation("CustomerMarkedBy")
  financeConfirmedAfterSalesOrders AfterSalesOrder[]           @relation("AfterSalesOrderFinanceConfirmedBy")
  warehouseConfirmedAfterSalesOrders AfterSalesOrder[]           @relation("AfterSalesOrderWarehouseConfirmedBy")
  handledAfterSalesOrders          AfterSalesOrder[]           @relation("AfterSalesOrderHandledBy")
  createdAfterSalesOrders          AfterSalesOrder[]           @relation("AfterSalesOrderCreatedBy")
  updatedAfterSalesOrders          AfterSalesOrder[]           @relation("AfterSalesOrderUpdatedBy")
  outreachSalesOrders              SalesOrder[]                @relation("SalesOrderOutreachUser")
  createdAgencyDeductionRules      AgencyDeductionRule[]       @relation("AgencyDeductionRuleCreatedBy")
  updatedAgencyDeductionRules      AgencyDeductionRule[]       @relation("AgencyDeductionRuleUpdatedBy")
  createdAgencyRebateRules         AgencyRebateRule[]          @relation("AgencyRebateRuleCreatedBy")
  updatedAgencyRebateRules         AgencyRebateRule[]          @relation("AgencyRebateRuleUpdatedBy")
  createdSalesDeductionRules       SalesDeductionRule[]        @relation("SalesDeductionRuleCreatedBy")
  updatedSalesDeductionRules       SalesDeductionRule[]        @relation("SalesDeductionRuleUpdatedBy")
  createdCommissionRules           CommissionRule[]            @relation("CommissionRuleCreatedBy")
  updatedCommissionRules           CommissionRule[]            @relation("CommissionRuleUpdatedBy")
  targetCommissionRecords          CommissionRecord[]          @relation("CommissionRecordTargetUser")
  confirmedCommissionRecords       CommissionRecord[]          @relation("CommissionRecordConfirmedBy")
  createdCommissionRecords         CommissionRecord[]          @relation("CommissionRecordCreatedBy")
  updatedCommissionRecords         CommissionRecord[]          @relation("CommissionRecordUpdatedBy")
  confirmedTravelGroupSummaries    TravelGroupFinanceSummary[] @relation("TravelGroupFinanceSummaryAgencyDeductionConfirmedBy")
  dailyRebatePaidTravelSummaries   TravelGroupFinanceSummary[] @relation("TravelGroupFinanceSummaryDailyRebatePaidBy")
  monthlyRebatePaidTravelSummaries TravelGroupFinanceSummary[] @relation("TravelGroupFinanceSummaryMonthlyRebatePaidBy")
  updatedTravelGroupSummaries      TravelGroupFinanceSummary[] @relation("TravelGroupFinanceSummaryUpdatedBy")
  reviewedDailyReconciliations     DailyReconciliation[]       @relation("DailyReconciliationReviewedBy")
  aiChatMessages                   AiChatMessage[]             @relation("AiChatMessageUser")
  createdProducts                  Product[]                   @relation("ProductCreatedBy")
  updatedProducts                  Product[]                   @relation("ProductUpdatedBy")
  createdProductActualCosts        ProductActualCost[]         @relation("ProductActualCostCreatedBy")
  updatedProductActualCosts        ProductActualCost[]         @relation("ProductActualCostUpdatedBy")
  createdSerializedInventoryUnits  SerializedInventoryUnit[]   @relation("SerializedInventoryUnitCreatedBy")
  updatedSerializedInventoryUnits  SerializedInventoryUnit[]   @relation("SerializedInventoryUnitUpdatedBy")
  correctedSerializedInventoryUnits SerializedInventoryUnit[]  @relation("SerializedInventoryUnitCorrectedBy")

  @@index([role])
  @@index([leaderId])
  @@index([statusChangedBy])
  @@map("users")
}

enum SmsVerificationPurpose {
  RESET_PASSWORD @map("reset_password")

  @@map("sms_verification_purpose")
}

model SmsVerificationCode {
  id           String                 @id @default(uuid()) @db.Char(36)
  phone        String                 @db.VarChar(30)
  userId       String?                @map("user_id") @db.Char(36)
  purpose      SmsVerificationPurpose
  codeHash     String                 @map("code_hash") @db.VarChar(255)
  activeKey    String?                @unique @map("active_key") @db.VarChar(191)
  expiresAt    DateTime               @map("expires_at") @db.DateTime(0)
  consumedAt   DateTime?              @map("consumed_at") @db.DateTime(0)
  attemptCount Int                    @default(0) @map("attempt_count")
  createdById  String?                @map("created_by_id") @db.Char(36)
  provider     String?                @db.VarChar(32)
  providerRef  String?                @map("provider_ref") @db.VarChar(128)
  createdAt    DateTime               @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt    DateTime               @updatedAt @map("updated_at") @db.DateTime(0)

  @@index([phone, purpose, createdAt])
  @@index([userId])
  @@index([expiresAt])
  @@map("sms_verification_codes")
}

model RateLimitCounter {
  keyFingerprint String   @id @map("key_fingerprint") @db.Char(64)
  scope          String   @db.VarChar(64)
  windowStartAt  DateTime @map("window_start_at") @db.DateTime(3)
  windowEndAt    DateTime @map("window_end_at") @db.DateTime(3)
  requestCount   Int      @default(0) @map("request_count")
  updatedAt      DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  @@index([windowEndAt], map: "rate_limit_counters_window_end_idx")
  @@map("rate_limit_counters")
}

model SystemSetting {
  id           String   @id @default(uuid()) @db.Char(36)
  settingKey   String   @unique @map("setting_key") @db.VarChar(191)
  settingValue String   @map("setting_value") @db.Text
  updatedBy    String?  @map("updated_by") @db.Char(36)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.DateTime(0)

  updater User? @relation("SystemSettingUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@index([updatedBy])
  @@map("system_settings")
}

model OperationLog {
  id         String   @id @default(uuid()) @db.Char(36)
  userId     String?  @map("user_id") @db.Char(36)
  action     String   @db.VarChar(100)
  entityType String   @map("entity_type") @db.VarChar(100)
  entityId   String?  @map("entity_id") @db.Char(36)
  beforeData Json?    @map("before_data")
  afterData  Json?    @map("after_data")
  sanitizationSummary Json? @map("sanitization_summary")
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(0)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("operation_logs")
}

model AiChatMessage {
  id               String   @id @default(uuid()) @db.Char(36)
  conversationId   String?  @map("conversation_id") @db.VarChar(64)
  userId           String   @map("user_id") @db.Char(36)
  userRole         String   @map("user_role") @db.VarChar(32)
  question         String   @db.Text
  answer           String   @db.Text
  intent           String?  @db.VarChar(64)
  dataScope        Json?    @map("data_scope")
  toolCalls        Json?    @map("tool_calls")
  sourceSummary    Json?    @map("source_summary")
  warnings         Json?
  modelProvider    String?  @map("model_provider") @db.VarChar(64)
  modelName        String?  @map("model_name") @db.VarChar(128)
  promptTokens     Int?     @map("prompt_tokens")
  completionTokens Int?     @map("completion_tokens")
  latencyMs        Int?     @map("latency_ms")
  errorCode        String?  @map("error_code") @db.VarChar(64)
  createdAt        DateTime @default(now()) @map("created_at") @db.DateTime(0)

  user User @relation("AiChatMessageUser", fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([conversationId, createdAt])
  @@index([intent, createdAt])
  @@map("ai_chat_messages")
}

enum InventoryTrackingMode {
  NONE       @map("none")
  SERIALIZED @map("serialized")

  @@map("inventory_tracking_mode")
}

enum SerializedInventoryStatus {
  PENDING_COST @map("pending_cost")
  AVAILABLE    @map("available")
  ALLOCATED    @map("allocated")
  VOID         @map("void")

  @@map("serialized_inventory_status")
}

model Product {
  id                    String                @id @default(uuid()) @db.Char(36)
  name                  String                @unique @db.VarChar(160)
  normalizedName        String                @unique @map("normalized_name") @db.VarChar(160)
  unit                  String                @db.VarChar(20)
  inventoryTrackingMode InventoryTrackingMode @default(NONE) @map("inventory_tracking_mode")
  isActive              Boolean               @default(true) @map("is_active")
  notes                 String?               @db.Text
  createdById           String?               @map("created_by_id") @db.Char(36)
  updatedById           String?               @map("updated_by_id") @db.Char(36)
  createdAt             DateTime              @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt             DateTime              @updatedAt @map("updated_at") @db.DateTime(0)

  actualCosts          ProductActualCost[]
  salesOrderItems      SalesOrderItem[]
  serializedInventoryUnits SerializedInventoryUnit[]
  tastingItems         TravelGroupTastingItem[]
  salesDeductionRules  SalesDeductionRule[]
  agencyDeductionRules AgencyDeductionRule[]
  createdBy            User?                    @relation("ProductCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy            User?                    @relation("ProductUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([isActive])
  @@index([inventoryTrackingMode])
  @@index([unit])
  @@index([createdById])
  @@index([updatedById])
  @@map("products")
}

model SerializedInventoryUnit {
  id                      String                    @id @default(uuid()) @db.Char(36)
  productId               String                    @map("product_id") @db.Char(36)
  salesOrderId            String?                   @map("sales_order_id") @db.Char(36)
  salesOrderItemId        String?                   @map("sales_order_item_id") @db.Char(36)
  moutaiName              String?                   @map("moutai_name") @db.VarChar(160)
  normalizedMoutaiName    String?                   @map("normalized_moutai_name") @db.VarChar(160)
  factoryDate             DateTime?                 @map("factory_date") @db.Date
  productionBatch         String?                   @map("production_batch") @db.VarChar(80)
  batchSerialNo           String?                   @map("batch_serial_no") @db.VarChar(80)
  logisticsCode           String?                   @map("logistics_code") @db.VarChar(160)
  normalizedLogisticsCode String?                   @unique @map("normalized_logistics_code") @db.VarChar(160)
  purchaseCostCents       Int?                      @map("purchase_cost_cents")
  orderCostSnapshotCents  Int?                      @map("order_cost_snapshot_cents")
  status                  SerializedInventoryStatus @default(PENDING_COST)
  correctionReason        String?                   @map("correction_reason") @db.VarChar(500)
  correctedById           String?                   @map("corrected_by_id") @db.Char(36)
  correctedAt             DateTime?                 @map("corrected_at") @db.DateTime(0)
  createdById             String?                   @map("created_by_id") @db.Char(36)
  updatedById             String?                   @map("updated_by_id") @db.Char(36)
  createdAt               DateTime                  @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt               DateTime                  @updatedAt @map("updated_at") @db.DateTime(0)

  product        Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  salesOrder     SalesOrder?     @relation(fields: [salesOrderId], references: [id], onDelete: SetNull)
  salesOrderItem SalesOrderItem? @relation(fields: [salesOrderItemId], references: [id], onDelete: SetNull)
  createdBy      User?           @relation("SerializedInventoryUnitCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy      User?           @relation("SerializedInventoryUnitUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  correctedBy    User?           @relation("SerializedInventoryUnitCorrectedBy", fields: [correctedById], references: [id], onDelete: SetNull)

  @@index([productId, status])
  @@index([moutaiName])
  @@index([normalizedMoutaiName])
  @@index([factoryDate])
  @@index([productionBatch])
  @@index([batchSerialNo])
  @@index([logisticsCode])
  @@index([status])
  @@index([salesOrderId])
  @@index([salesOrderItemId])
  @@index([createdById])
  @@index([updatedById])
  @@index([correctedById])
  @@map("serialized_inventory_units")
}

model ProductActualCost {
  id            String    @id @default(uuid()) @db.Char(36)
  productId     String    @map("product_id") @db.Char(36)
  costCents     Int       @map("cost_cents")
  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date
  isActive      Boolean   @default(true) @map("is_active")
  notes         String?   @db.Text
  createdById   String?   @map("created_by_id") @db.Char(36)
  updatedById   String?   @map("updated_by_id") @db.Char(36)
  createdAt     DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.DateTime(0)

  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  createdBy User?   @relation("ProductActualCostCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User?   @relation("ProductActualCostUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([productId, isActive, effectiveFrom])
  @@index([productId, isActive, effectiveTo])
  @@index([createdById])
  @@index([updatedById])
  @@map("product_actual_costs")
}

model TravelAgency {
  id           String   @id @default(uuid()) @db.Char(36)
  name         String   @unique @db.VarChar(120)
  contactName  String?  @map("contact_name") @db.VarChar(80)
  contactPhone String?  @map("contact_phone") @db.VarChar(30)
  notes        String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.DateTime(0)

  agencyDeductionRules AgencyDeductionRule[]
  agencyRebateRules    AgencyRebateRule[]
  commissionRecords    CommissionRecord[]

  @@index([contactPhone])
  @@map("travel_agencies")
}

model Guide {
  id           String   @id @default(uuid()) @db.Char(36)
  name         String   @db.VarChar(80)
  phone        String   @unique @db.VarChar(30)
  travelAgency String?  @map("travel_agency") @db.VarChar(120)
  remarks      String?  @db.Text
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.DateTime(0)

  travelGroups TravelGroup[]

  @@index([name])
  @@index([travelAgency])
  @@index([isActive])
  @@map("guides")
}

enum TravelGroupStatus {
  UNMARKED        @map("unmarked")
  PENDING_SUMMARY @map("pending_summary")
  ORDERED         @map("ordered")

  @@map("travel_group_status")
}

enum SalesOrderType {
  TRAVEL_GROUP @map("travel_group")
  BUYBACK      @map("buyback")
  EXTERNAL     @map("external")
  INTERNAL     @map("internal")
  AFTER_SALES  @map("after_sales")

  @@map("sales_order_type")
}

enum SalesOrderStatus {
  VALID          @map("valid")
  PARTIAL_REFUND @map("partial_refund")
  REFUNDED       @map("refunded")
  CANCELLED      @map("cancelled")

  @@map("sales_order_status")
}

enum SalesOrderDeliveryType {
  SELF_PICKUP @map("self_pickup")
  SHIPPING    @map("shipping")

  @@map("sales_order_delivery_type")
}

enum SalesOrderPackingStatus {
  PENDING  @map("pending")
  PACKING  @map("packing")
  PACKED   @map("packed")
  ABNORMAL @map("abnormal")

  @@map("sales_order_packing_status")
}

enum AfterSalesIssueType {
  QUALITY_ISSUE    @map("quality_issue")
  LOGISTICS_DAMAGE @map("logistics_damage")
  WRONG_ITEM       @map("wrong_item")
  MISSING_ITEM     @map("missing_item")
  CUSTOMER_RETURN  @map("customer_return")
  INVOICE_ISSUE    @map("invoice_issue")
  OTHER            @map("other")

  @@map("after_sales_issue_type")
}

enum AfterSalesActionType {
  RECORD_ONLY   @map("record_only")
  REFUND        @map("refund")
  RETURN_REFUND @map("return_refund")
  RESEND        @map("resend")
  EXCHANGE      @map("exchange")
  CANCEL_ORDER  @map("cancel_order")

  @@map("after_sales_action_type")
}

enum AfterSalesStatus {
  NEGOTIATING     @map("negotiating")
  WAITING_RECEIVE @map("waiting_receive")
  WAITING_RESEND  @map("waiting_resend")
  WAITING_REFUND  @map("waiting_refund")
  COMPLETED       @map("completed")

  @@map("after_sales_status")
}

enum ReconciliationReviewStatus {
  PENDING_REVIEW @map("pending_review")
  REVIEWED       @map("reviewed")

  @@map("reconciliation_review_status")
}

enum CommissionRuleTargetType {
  SALES_COMMISSION    @map("sales_commission")
  OUTREACH_COMMISSION @map("outreach_commission")
  LEADER_COMMISSION   @map("leader_commission")

  @@map("commission_rule_target_type")
}

enum CommissionTargetType {
  SALES_COMMISSION      @map("sales_commission")
  OUTREACH_COMMISSION   @map("outreach_commission")
  LEADER_COMMISSION     @map("leader_commission")
  TASTER_COMMISSION     @map("taster_commission")
  AGENCY_DAILY_REBATE   @map("agency_daily_rebate")
  AGENCY_MONTHLY_REBATE @map("agency_monthly_rebate")

  @@map("commission_target_type")
}

model TravelGroup {
  id                       String            @id @default(uuid()) @db.Char(36)
  groupNo                  String            @unique @map("group_no") @db.VarChar(80)
  visitDate                DateTime          @map("visit_date") @db.Date
  travelAgency             String?           @map("travel_agency") @db.VarChar(120)
  licensePlate             String?           @map("license_plate") @db.VarChar(40)
  guideName                String?           @map("guide_name") @db.VarChar(80)
  guidePhone               String?           @map("guide_phone") @db.VarChar(30)
  guestCount               Int               @default(0) @map("guest_count")
  tastingRoomNo            String?           @map("tasting_room_no") @db.VarChar(40)
  tasterName               String?           @map("taster_name") @db.VarChar(80)
  sourceRegion             String?           @map("source_region") @db.VarChar(120)
  ageInfo                  String?           @map("age_info") @db.VarChar(120)
  mentionedFeitian         Boolean?          @map("mentioned_feitian")
  previousStopOrderStatus  String?           @map("previous_stop_order_status") @db.VarChar(255)
  keyCustomerInfo          String?           @map("key_customer_info") @db.Text
  /// Attachment metadata array only; file binaries are stored outside the database.
  keyCustomerPhotos        Json?             @map("key_customer_photos")
  /// Attachment metadata array only; file binaries are stored outside the database.
  guestInfoAttachments     Json?             @map("guest_info_attachments")
  liaisonTasterId          String?           @map("liaison_taster_id") @db.Char(36)
  liaisonTasterName        String?           @map("liaison_taster_name") @db.VarChar(80)
  expectedArrivalTime      String?           @map("expected_arrival_time") @db.VarChar(30)
  arrivalTime              String?           @map("arrival_time") @db.VarChar(30)
  groupType                String?           @map("group_type") @db.VarChar(60)
  wineDetails              String?           @map("wine_details") @db.Text
  departureTime            String?           @map("departure_time") @db.VarChar(30)
  remarks                  String?           @db.Text
  status                   TravelGroupStatus @default(UNMARKED)
  salesAmountCents         Int               @default(0) @map("sales_amount_cents")
  paidDepositCents         Int               @default(0) @map("paid_deposit_cents")
  cashOnDeliveryCents      Int               @default(0) @map("cash_on_delivery_cents")
  liquorCostDeductionCents Int               @default(0) @map("liquor_cost_deduction_cents")
  orderAmountCents         Int               @default(0) @map("order_amount_cents")
  points                   Int               @default(0)
  returnedPoints           Int               @default(0) @map("returned_points")
  unreturnedPoints         Int               @default(0) @map("unreturned_points")
  guideInfoSent            Boolean           @default(false) @map("guide_info_sent")
  travelAgencyInfoSent     Boolean           @default(false) @map("travel_agency_info_sent")
  financeMark              Boolean           @default(false) @map("finance_mark")
  markedById               String?           @map("marked_by") @db.Char(36)
  markedAt                 DateTime?         @map("marked_at") @db.DateTime(0)
  guideId                  String?           @map("guide_id") @db.Char(36)
  tasterId                 String?           @map("taster_id") @db.Char(36)
  tasterSummary            String?           @map("taster_summary") @db.Text
  tasterSummaryAt          DateTime?         @map("taster_summary_at") @db.DateTime(0)
  postMarkEditedAt         DateTime?         @map("post_mark_edited_at") @db.DateTime(0)
  postMarkEditedById       String?           @map("post_mark_edited_by_id") @db.Char(36)
  createdById              String?           @map("created_by_id") @db.Char(36)
  updatedById              String?           @map("updated_by_id") @db.Char(36)
  createdAt                DateTime          @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt                DateTime          @updatedAt @map("updated_at") @db.DateTime(0)

  salesOrders       SalesOrder[]
  tastingItems      TravelGroupTastingItem[]
  commissionRecords CommissionRecord[]
  financeSummary    TravelGroupFinanceSummary?
  guide             Guide?                     @relation(fields: [guideId], references: [id], onDelete: SetNull)
  taster            User?                      @relation("TravelGroupTaster", fields: [tasterId], references: [id], onDelete: SetNull)
  liaisonTaster     User?                      @relation("TravelGroupLiaisonTaster", fields: [liaisonTasterId], references: [id], onDelete: SetNull)
  markedBy          User?                      @relation("TravelGroupMarkedBy", fields: [markedById], references: [id], onDelete: SetNull)

  @@index([visitDate])
  @@index([travelAgency])
  @@index([guideName])
  @@index([guideId])
  @@index([tasterName])
  @@index([tasterId])
  @@index([liaisonTasterId])
  @@index([financeMark])
  @@index([markedById])
  @@index([groupType])
  @@index([status])
  @@index([visitDate, tasterId])
  @@index([visitDate, financeMark])
  @@index([visitDate, groupType])
  @@map("travel_groups")
}

model TravelGroupTastingItem {
