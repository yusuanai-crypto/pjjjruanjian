  agencyId                   String?              @map("agency_id") @db.Char(36)
  agencyName                 String?              @map("agency_name") @db.VarChar(120)
  grossAmountCents           Int                  @default(0) @map("gross_amount_cents")
  confirmedRefundAmountCents Int                  @default(0) @map("confirmed_refund_amount_cents")
  baseAmountCents            Int                  @default(0) @map("base_amount_cents")
  deductionAmountCents       Int                  @default(0) @map("deduction_amount_cents")
  rateSnapshot               Decimal?             @map("rate_snapshot") @db.Decimal(10, 4)
  amountCents                Int                  @default(0) @map("amount_cents")
  pointsCents                Int                  @default(0) @map("points_cents")
  manualInput                Boolean              @default(false) @map("manual_input")
  isConfirmed                Boolean              @default(false) @map("is_confirmed")
  confirmedById              String?              @map("confirmed_by_id") @db.Char(36)
  confirmedAt                DateTime?            @map("confirmed_at") @db.DateTime(0)
  calculationVersion         String               @default("stage7_v1") @map("calculation_version") @db.VarChar(40)
  calculationNote            String?              @map("calculation_note") @db.Text
  ruleSnapshot               Json?                @map("rule_snapshot")
  sourceSnapshot             Json?                @map("source_snapshot")
  createdById                String?              @map("created_by_id") @db.Char(36)
  updatedById                String?              @map("updated_by_id") @db.Char(36)
  createdAt                  DateTime             @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt                  DateTime             @updatedAt @map("updated_at") @db.DateTime(0)

  salesOrder       SalesOrder?       @relation(fields: [salesOrderId], references: [id], onDelete: SetNull)
  travelGroup      TravelGroup?      @relation(fields: [travelGroupId], references: [id], onDelete: SetNull)
  afterSalesOrder  AfterSalesOrder?  @relation(fields: [afterSalesOrderId], references: [id], onDelete: SetNull)
  commissionRule   CommissionRule?   @relation(fields: [commissionRuleId], references: [id], onDelete: SetNull)
  agencyRebateRule AgencyRebateRule? @relation(fields: [agencyRebateRuleId], references: [id], onDelete: SetNull)
  targetUser       User?             @relation("CommissionRecordTargetUser", fields: [targetUserId], references: [id], onDelete: SetNull)
  agency           TravelAgency?     @relation(fields: [agencyId], references: [id], onDelete: SetNull)
  confirmedBy      User?             @relation("CommissionRecordConfirmedBy", fields: [confirmedById], references: [id], onDelete: SetNull)
  createdBy        User?             @relation("CommissionRecordCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy        User?             @relation("CommissionRecordUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([salesOrderId])
  @@index([travelGroupId])
  @@index([afterSalesOrderId])
  @@index([commissionRuleId])
  @@index([agencyRebateRuleId])
  @@index([targetType])
  @@index([targetUserId])
  @@index([agencyId])
  @@index([agencyName])
  @@index([manualInput])
  @@index([isConfirmed])
  @@index([confirmedById])
  @@index([createdById])
  @@index([updatedById])
  @@index([createdAt])
  @@index([targetType, targetUserId, createdAt])
  @@index([travelGroupId, targetType])
  @@map("commission_records")
}

model TravelGroupFinanceSummary {
  id                           String    @id @default(uuid()) @db.Char(36)
  travelGroupId                String    @unique @map("travel_group_id") @db.Char(36)
  totalSalesAmountCents        Int       @default(0) @map("total_sales_amount_cents")
  totalCashOnDeliveryCents      Int       @default(0) @map("total_cash_on_delivery_cents")
  totalPaidDepositCents         Int       @default(0) @map("total_paid_deposit_cents")
  confirmedRefundAmountCents   Int       @default(0) @map("confirmed_refund_amount_cents")
  effectiveSalesAmountCents    Int       @default(0) @map("effective_sales_amount_cents")
  totalAgencyDeductionCents    Int       @default(0) @map("total_agency_deduction_cents")
  agencyDeductionConfirmed     Boolean   @default(false) @map("agency_deduction_confirmed")
  agencyDeductionConfirmedById String?   @map("agency_deduction_confirmed_by_id") @db.Char(36)
  agencyDeductionConfirmedAt   DateTime? @map("agency_deduction_confirmed_at") @db.DateTime(0)
  totalAgencyNetAmountCents    Int       @default(0) @map("total_agency_net_amount_cents")
  totalDailyRebateCents        Int       @default(0) @map("total_daily_rebate_cents")
  totalMonthlyRebateCents      Int       @default(0) @map("total_monthly_rebate_cents")
  paidRebateCents              Int       @default(0) @map("paid_rebate_cents")
  unpaidRebateCents            Int       @default(0) @map("unpaid_rebate_cents")
  dailyRebatePaid              Boolean   @default(false) @map("daily_rebate_paid")
  dailyRebatePaidById          String?   @map("daily_rebate_paid_by_id") @db.Char(36)
  dailyRebatePaidAt            DateTime? @map("daily_rebate_paid_at") @db.DateTime(0)
  monthlyRebatePaid            Boolean   @default(false) @map("monthly_rebate_paid")
  monthlyRebatePaidById        String?   @map("monthly_rebate_paid_by_id") @db.Char(36)
  monthlyRebatePaidAt          DateTime? @map("monthly_rebate_paid_at") @db.DateTime(0)
  notes                        String?   @db.Text
  guideInfoSent                Boolean   @default(false) @map("guide_info_sent")
  travelAgencyInfoSent         Boolean   @default(false) @map("travel_agency_info_sent")
  calculationVersion           String    @default("stage7_v1") @map("calculation_version") @db.VarChar(40)
  sourceSnapshot               Json?     @map("source_snapshot")
  updatedById                  String?   @map("updated_by_id") @db.Char(36)
  createdAt                    DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt                    DateTime  @updatedAt @map("updated_at") @db.DateTime(0)

  travelGroup                TravelGroup @relation(fields: [travelGroupId], references: [id], onDelete: Cascade)
  agencyDeductionConfirmedBy User?       @relation("TravelGroupFinanceSummaryAgencyDeductionConfirmedBy", fields: [agencyDeductionConfirmedById], references: [id], onDelete: SetNull, map: "tg_fin_summaries_confirmed_by_id_fkey")
  dailyRebatePaidBy          User?       @relation("TravelGroupFinanceSummaryDailyRebatePaidBy", fields: [dailyRebatePaidById], references: [id], onDelete: SetNull, map: "tg_fin_summaries_daily_paid_by_id_fkey")
  monthlyRebatePaidBy        User?       @relation("TravelGroupFinanceSummaryMonthlyRebatePaidBy", fields: [monthlyRebatePaidById], references: [id], onDelete: SetNull, map: "tg_fin_summaries_monthly_paid_by_id_fkey")
  updatedBy                  User?       @relation("TravelGroupFinanceSummaryUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([agencyDeductionConfirmed])
  @@index([agencyDeductionConfirmedById], map: "tg_fin_summaries_confirmed_by_id_idx")
  @@index([dailyRebatePaid])
  @@index([dailyRebatePaidById], map: "tg_fin_summaries_daily_paid_by_id_idx")
  @@index([monthlyRebatePaid])
  @@index([monthlyRebatePaidById], map: "tg_fin_summaries_monthly_paid_by_id_idx")
  @@index([updatedById])
  @@index([updatedAt])
  @@map("travel_group_finance_summaries")
}

model DailyReconciliation {
  id                    String                     @id @default(uuid()) @db.Char(36)
  businessDate          DateTime                   @unique @map("business_date") @db.Date
  travelGroupSalesCents Int                        @default(0) @map("travel_group_sales_cents")
  backOfficeSalesCents  Int                        @default(0) @map("back_office_sales_cents")
  buybackCents          Int                        @default(0) @map("buyback_cents")
  externalSalesCents    Int                        @default(0) @map("external_sales_cents")
  internalPurchaseCents Int                        @default(0) @map("internal_purchase_cents")
  afterSalesCents       Int                        @default(0) @map("after_sales_cents")
  /// Positive refund deduction amount; receivable totals subtract this value.
  refundsCents          Int                        @default(0) @map("refunds_cents")
  otherReceivableCents  Int                        @default(0) @map("other_receivable_cents")
  notes                 String?                    @db.Text
  reviewStatus          ReconciliationReviewStatus @default(PENDING_REVIEW) @map("review_status")
  reviewedById          String?                    @map("reviewed_by_id") @db.Char(36)
  reviewedAt            DateTime?                  @map("reviewed_at") @db.DateTime(0)
  reviewSourceHash      String?                    @map("review_source_hash") @db.VarChar(64)
  createdById           String?                    @map("created_by_id") @db.Char(36)
  updatedById           String?                    @map("updated_by_id") @db.Char(36)
  createdAt             DateTime                   @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt             DateTime                   @updatedAt @map("updated_at") @db.DateTime(0)

  paymentMethods ReconciliationPaymentMethod[]
  reviewedBy     User?                         @relation("DailyReconciliationReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([reviewStatus, businessDate])
  @@index([reviewedById])
  @@map("daily_reconciliations")
}

model ReconciliationPaymentMethod {
  id               String   @id @default(uuid()) @db.Char(36)
  reconciliationId String   @map("reconciliation_id") @db.Char(36)
  name             String   @db.VarChar(80)
  amountCents      Int      @default(0) @map("amount_cents")
  sortOrder        Int      @default(0) @map("sort_order")
  createdAt        DateTime @default(now()) @map("created_at") @db.DateTime(0)

  reconciliation DailyReconciliation @relation(fields: [reconciliationId], references: [id], onDelete: Cascade)

  @@index([reconciliationId])
  @@map("reconciliation_payment_methods")
}

model StrikeBonusAward {
  id               String    @id @default(uuid()) @db.Char(36)
  bonusDate        DateTime  @map("bonus_date") @db.Date
  travelAgency     String?   @map("travel_agency") @db.VarChar(120)
  guideName        String?   @map("guide_name") @db.VarChar(80)
  tasterName       String?   @map("taster_name") @db.VarChar(80)
  roomNo           String?   @map("room_no") @db.VarChar(40)
  salesAmountCents Int       @default(0) @map("sales_amount_cents")
  bonusAmountCents Int       @default(0) @map("bonus_amount_cents")
  tasterPaidDate   DateTime? @map("taster_paid_date") @db.Date
  salesPaidDate    DateTime? @map("sales_paid_date") @db.Date
  createdAt        DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.DateTime(0)

  @@index([bonusDate])
  @@index([travelAgency])
  @@index([guideName])
  @@index([tasterName])
  @@map("strike_bonus_awards")
}
